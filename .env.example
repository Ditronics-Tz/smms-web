# SMMS Web Docker Environment Variables
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# Firebase / Web Push Notifications (OPTIONAL BLOCK)
# -----------------------------------------------------------------------------
# This whole block is optional. Leave every REACT_APP_FIREBASE_* var blank (or
# delete the block) to run WITHOUT Firebase: the app boots normally, no browser
# permission prompt appears, the push service worker stays inert, and all push
# flows are silently disabled.
#
# To ENABLE web push you must set ALL of the values below to a valid, matching
# set from a single Firebase web app, plus REACT_APP_VAPID_KEY. If any of the
# six core fields or the VAPID key is missing, Firebase is skipped entirely and
# a single console warning explains which var is missing.
#   - REACT_APP_VAPID_KEY: Cloud Messaging -> Web push certificates -> Key pair.
#   - The remaining values come from Firebase Console -> Project settings ->
#     General -> Your apps -> Web app (SDK setup and configuration).
# REACT_APP_FIREBASE_MEASUREMENT_ID is OPTIONAL (Google Analytics only) and is
# not required for push notifications; omit it if you do not use Analytics.
#
# Required for push:
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
# VAPID key (Cloud Messaging -> Web push certificates):
REACT_APP_VAPID_KEY=your_vapid_key
# Optional (Analytics only, not needed for push):
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=production

# Backend API base URL
# MUST-SET-PER-DEPLOYMENT: REACT_APP_API_BASE_URL has NO baked-in production
# default. Set it for every deployment. A missing value in a production build
# logs a loud warning at runtime instead of silently hitting a local backend.
#   - development builds (`npm start`) read .env.development  (dev-only localhost fallback)
#   - production builds  (`npm run build`) read .env.production
# Leave this out to use the dev-only localhost fallback (development only).
REACT_APP_API_BASE_URL=

# -----------------------------------------------------------------------------
# Branding / White-label (all OPTIONAL -- sensible defaults shown)
# -----------------------------------------------------------------------------
# Re-skins the whole app without touching source code. When left blank the
# built-in defaults below are used. Values set here also feed the browser
# <title>, meta description, manifest.json (app name / theme color) and favicon,
# which scripts/generate-public-assets.js regenerates at build/start time from
# these vars (defaults applied when a var is missing).
REACT_APP_APP_NAME=Meal Management System
REACT_APP_APP_SHORT_NAME=MMS
REACT_APP_APP_DESCRIPTION=Meal management platform for schools and cafeterias
# Path must point to a file inside public/ (e.g. /logo.png). Blank = bundled default logo.
REACT_APP_LOGO_PATH=
# Path to a file inside public/ (e.g. /favicon.png). Blank = bundled favicon.ico.
REACT_APP_FAVICON_PATH=
# Theme primary color (used across MUI palette and PWA theme_color).
REACT_APP_PRIMARY_COLOR=#FFA500
# Currency shown next to money values in the UI.
REACT_APP_CURRENCY_SYMBOL=$
REACT_APP_CURRENCY_CODE=USD
# Default language bundle ('en' or 'sw'); users can still switch in the header.
REACT_APP_DEFAULT_LOCALE=en
# REQUIRED for the Support page contact cards. If left blank, a console warning
# is logged at startup listing whichever of these two is missing.
REACT_APP_SUPPORT_EMAIL=
REACT_APP_SUPPORT_PHONE=