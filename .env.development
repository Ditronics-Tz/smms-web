# =============================================================================
# Development environment (loaded by CRA automatically when NODE_ENV=development)
# Used by `npm start` / `make dev`. Backend runs locally during development.
# =============================================================================
REACT_APP_API_BASE_URL=http://127.0.0.1:8000

# Currency (Tanzanian shillings). Leave unset to use the built-in TSh / TZS.
# REACT_APP_CURRENCY_SYMBOL=TSh
# REACT_APP_CURRENCY_CODE=TZS

# -----------------------------------------------------------------------------
# Ledger mocks (FE-10)
# -----------------------------------------------------------------------------
# Flip to true to answer /ledger/* from src/mocks/ledger.ts while BE-28/BE-29 are
# still in progress. The mock data matches the API contract exactly, so the pages
# behave the same either way.
REACT_APP_USE_MOCKS=true

# -----------------------------------------------------------------------------
# Support contact details
#
# The Help & Support page turns each of these into a real link: the phone
# becomes a tel: link, the email a mailto: link, and the chat URL opens in a new
# tab. Anything left empty is shown as "Not configured yet" rather than as a
# dead "#" placeholder, so a missing value is obvious instead of looking broken.
# -----------------------------------------------------------------------------
# REACT_APP_SUPPORT_EMAIL=support@example.com
# REACT_APP_SUPPORT_PHONE=
# REACT_APP_SUPPORT_CHAT_URL=

# -----------------------------------------------------------------------------
# Firebase / Web Push Notifications
#
# Leave these COMMENTED OUT until you have real values from the Firebase console.
# A placeholder like `your_api_key` is still a non-empty string, so it makes the
# app believe push is configured and try to register a service worker that cannot
# work. With everything commented out the app logs one clear
# "[firebase] Push notifications disabled" warning and runs normally.
# -----------------------------------------------------------------------------
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
# REACT_APP_FIREBASE_MEASUREMENT_ID=
# REACT_APP_VAPID_KEY=
